# API URL for frontend to connect to API service
# Uncomment for local development with separate API server
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL for CORS configuration (production only)
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Default AI model to use for analysis
# Options: gpt-4.1-nano-2025-04-14, gpt-4o, gpt-4-turbo, etc.
DEFAULT_MODEL=gpt-4.1-nano-2025-04-14

# OpenAI API Key (required if using GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required if using Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
