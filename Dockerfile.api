# Dockerfile for API Services
FROM node:22-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Dependencies stage
FROM base AS deps
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Builder stage
FROM base AS builder
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy only API-related files and necessary configs
COPY package.json pnpm-lock.yaml ./
COPY next.config.ts ./
COPY tsconfig.json ./
COPY next-env.d.ts ./
COPY postcss.config.mjs ./
COPY components.json ./

# Copy source files needed for API
COPY src/lib ./src/lib
COPY src/app/api ./src/app/api
COPY src/proxy.ts ./src/proxy.ts

# Create minimal layout and page for Next.js build requirement
COPY src/app/layout.tsx ./src/app/layout.tsx
COPY src/app/globals.css ./src/app/globals.css

# Create a minimal root page (required by Next.js)
RUN echo 'export default function Page() { return null; }' > src/app/page.tsx

# Build Next.js with standalone output
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm build

# Runner stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Accept non-sensitive configuration as build args
ARG DEFAULT_MODEL=gpt-4.1-nano-2025-04-14
ARG NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Set non-sensitive environment variables from build args
ENV DEFAULT_MODEL=$DEFAULT_MODEL
ENV NEXT_PUBLIC_FRONTEND_URL=$NEXT_PUBLIC_FRONTEND_URL

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built files from builder
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
